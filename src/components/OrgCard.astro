---
import { Image } from 'astro:assets';
import type { Org } from '../data/orgs';
interface Props { org: Org; compact?: boolean }
const { org, compact = false } = Astro.props;
const ig = org.instagram ? `https://www.instagram.com/${org.instagram}/` : undefined;
---
<article class:list={['card flex gap-4 items-start', compact ? 'p-3' : 'p-4']}>
  <a href={org.url ?? ig} class:list={['shrink-0 grid place-items-center overflow-hidden', org.round ? 'rounded-full' : 'rounded-lg', org.lightChip ? 'bg-white p-2' : 'p-1']} style={`width:${org.wide ? (compact ? 150 : 200) : compact ? 64 : 88}px;height:${compact ? 64 : 88}px`} aria-label={org.name}>
    <Image src={org.logo} alt={`Logo de ${org.name}`} width={400} widths={[200, 400]} sizes="200px" class="max-w-full max-h-full object-contain" loading="lazy" />
  </a>
  <div class="min-w-0">
    <h3 class="display font-bold leading-tight">{org.name}</h3>
    <p class="text-sm font-bold" style="color: var(--amber)">{org.role}</p>
    {!compact && <p class="muted text-sm mt-1">{org.description}</p>}
    <p class="text-sm mt-2 flex flex-wrap gap-3">
      {org.url && <a href={org.url} class="underline decoration-[var(--amber)]">Sitio web</a>}
      {ig && <a href={ig} class="underline decoration-[var(--amber)]">Instagram @{org.instagram}</a>}
      <span class="muted">{org.city}</span>
    </p>
  </div>
</article>
