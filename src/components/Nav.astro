---
import { site } from '../site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/cv', label: 'CV' },
  { href: '/portafolio', label: 'Portafolio' },
  { href: '/dev', label: 'Utilidades' },
  { href: '/salsa', label: 'Salsa' },
  { href: '/galeria', label: 'Galería' },
];
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<header class:list={['no-print z-20', overlay ? 'absolute inset-x-0 top-0' : 'border-b']} style={overlay ? '' : 'border-color: var(--border)'}>
  <!-- En pantallas estrechas los enlaces bajan a una segunda fila centrada; desde sm caben en una sola. -->
  <nav class="max-w-6xl mx-auto px-4 py-2 sm:py-0 sm:h-16 flex flex-wrap sm:flex-nowrap items-center gap-x-4 gap-y-1">
    <a href="/" class="display font-bold tracking-wide uppercase text-lg">{site.shortName}</a>
    <ul class="flex flex-wrap justify-center gap-1 text-sm basis-full order-last sm:basis-auto sm:order-none sm:ml-auto">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['px-2 sm:px-3 py-1.5 rounded-md hover:bg-white/10', active(l.href) && 'font-bold']}
            style={active(l.href) ? 'color: var(--amber)' : ''}
            aria-current={active(l.href) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <button id="theme-toggle" class="ml-auto sm:ml-1 p-2 rounded-md hover:bg-white/10" aria-label="Cambiar tema" title="Cambiar tema">
      <span class="dark:hidden">🌙</span><span class="hidden dark:inline">☀️</span>
    </button>
  </nav>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>
