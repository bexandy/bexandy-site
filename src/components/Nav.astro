---
import { site } from '../site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/cv', label: 'CV' },
  { href: '/portafolio', label: 'Portafolio' },
  { href: '/dev', label: 'Utilidades' },
  { href: '/salsa', label: 'Salsa' },
];
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<header class:list={['no-print z-20', overlay ? 'absolute inset-x-0 top-0' : 'border-b']} style={overlay ? '' : 'border-color: var(--border)'}>
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center gap-4">
    <a href="/" class="display font-bold tracking-wide uppercase text-lg">{site.shortName}</a>
    <ul class="flex gap-1 ml-auto text-sm">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['px-3 py-1.5 rounded-md hover:bg-white/10', active(l.href) && 'font-bold']}
            style={active(l.href) ? 'color: var(--amber)' : ''}
            aria-current={active(l.href) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <button id="theme-toggle" class="ml-1 p-2 rounded-md hover:bg-white/10" aria-label="Cambiar tema" title="Cambiar tema">
      <span class="dark:hidden">🌙</span><span class="hidden dark:inline">☀️</span>
    </button>
  </nav>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>
