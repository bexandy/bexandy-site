---
import { site } from '../site';
const path = Astro.url.pathname;
const links = [
  { href: '/cv', label: 'CV' },
  { href: '/portafolio', label: 'Portafolio' },
  { href: '/dev', label: 'Utilidades' },
  { href: '/salsa', label: 'Salsa' },
];
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="no-print border-b" style="border-color: var(--border)">
  <nav class="max-w-5xl mx-auto px-4 h-14 flex items-center gap-4">
    <a href="/" class="font-bold tracking-tight">{site.shortName}</a>
    <ul class="flex gap-1 ml-auto text-sm">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10',
              active(l.href) && 'bg-black/5 dark:bg-white/10 font-medium',
            ]}
            aria-current={active(l.href) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <button id="theme-toggle" class="ml-2 p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/10" aria-label="Cambiar tema" title="Cambiar tema">
      <span class="dark:hidden">🌙</span><span class="hidden dark:inline">☀️</span>
    </button>
  </nav>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>
