---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { academies } from '../../../data/orgs';
const videos = (await getCollection('videos', ({ data }) => !data.draft)).sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || b.data.likes - a.data.likes || b.data.date.valueOf() - a.data.date.valueOf());
const groups = [
  ...academies.map((a) => ({ key: a.id, name: a.name, org: a })),
  { key: 'otro', name: 'Otros lugares', org: undefined },
].map((g) => ({ ...g, items: videos.filter((v) => v.data.academy === g.key) })).filter((g) => g.items.length > 0);
const fmt = (d: Date) => d.toLocaleDateString('es-CL', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---
<Base title="Clases de salsa en video" side="dance">
  <div class="eyebrow mb-2">Baile</div>
  <h1 class="display font-bold text-4xl">Clases en video</h1>
  <p class="muted mt-2 max-w-xl">Grabaciones de las clases y prácticas a las que asisto como alumno, agrupadas por la academia donde se hicieron y ordenadas por los "me gusta" que recibieron en TikTok.</p>

  <nav class="flex flex-wrap gap-2 mt-6 text-sm no-print" aria-label="Academias">
    {groups.map((g) => <a href={`#${g.key}`} class="chip hover:border-amber">{g.name} · {g.items.length}</a>)}
  </nav>

  {groups.map((g) => (
    <section id={g.key} class="mt-10 scroll-mt-20">
      <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
        <h2 class="display font-bold text-2xl">{g.name}</h2>
        {g.org?.instagram && <a href={`https://www.instagram.com/${g.org.instagram}/`} class="text-sm underline decoration-[var(--amber)]">@{g.org.instagram}</a>}
      </div>
      <ul class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {g.items.map((v) => (
          <li>
            <a href={`/salsa/clases/${v.id}`} class="card block p-4 h-full hover:border-amber transition-colors">
              {v.data.featured && <div class="eyebrow mb-1">Destacado</div>}
              <h3 class="display font-bold leading-tight">{v.data.title}</h3>
              <p class="muted text-sm mt-1">{fmt(v.data.date)} · {v.data.style}{v.data.likes ? ` · ♥ ${v.data.likes}` : ''}</p>
              {v.data.figures.length > 0 && <ul class="flex flex-wrap gap-1 mt-2">{v.data.figures.slice(0, 4).map((f) => <li class="chip">{f}</li>)}</ul>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
