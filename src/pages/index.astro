---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---
<Base title={site.name} side="neutral">
  <section class="py-10">
    <p class="muted text-sm uppercase tracking-widest">Hola, soy</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mt-2">{site.name}</h1>
    <p class="mt-4 text-lg max-w-2xl muted">
      Desarrollador de software de día y bailarín de salsa de noche. Aquí vive mi trabajo y lo que hago
      cuando no estoy frente a un teclado.
    </p>
  </section>

  <section class="grid md:grid-cols-2 gap-6 mt-6">
    <a href="/portafolio" class="card p-8 hover:shadow-lg transition-shadow" style="border-top: 6px solid var(--color-work)">
      <h2 class="text-2xl font-bold">Trabajo</h2>
      <p class="muted mt-2">CV, portafolio de proyectos y utilidades para desarrollo e inteligencia artificial.</p>
      <ul class="mt-4 flex flex-wrap gap-2 text-sm">
        <li class="underline">Currículum</li>
        <li class="underline">Portafolio</li>
        <li class="underline">Utilidades dev e IA</li>
      </ul>
    </a>
    <a href="/salsa" class="card p-8 hover:shadow-lg transition-shadow" style="border-top: 6px solid var(--color-dance)">
      <h2 class="text-2xl font-bold">Baile</h2>
      <p class="muted mt-2">Reproductor para practicar salsa (separa instrumentos, cambia la velocidad y marca los conteos) y videos de mis clases.</p>
      <ul class="mt-4 flex flex-wrap gap-2 text-sm">
        <li class="underline">Reproductor de práctica</li>
        <li class="underline">Clases en video</li>
      </ul>
    </a>
  </section>
</Base>
