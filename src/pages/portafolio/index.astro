---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { img } from '../../lib/images';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const work = projects.filter((p) => p.data.side === 'work');
const dance = projects.filter((p) => p.data.side === 'dance');
---
<Base title="Portafolio" side="work">
  <div class="eyebrow mb-2">Portafolio</div>
  <h1 class="display font-bold text-4xl">Lo que he construido</h1>
  <p class="muted mt-2 max-w-xl">Sistemas de trabajo y proyectos personales. Los de baile también cuentan.</p>

  <h2 class="display font-bold text-2xl mt-10 mb-4">Trabajo</h2>
  <div class="grid md:grid-cols-3 gap-4">
    {work.map((p) => (
      <Card href={`/portafolio/${p.id}`} title={p.data.title} subtitle={p.data.summary} tags={p.data.stack.slice(0, 4)} cover={img(p.data.cover)} eyebrow={`${p.data.date.getFullYear()}${p.data.role ? ` · ${p.data.role.split(',')[0]}` : ''}`} />
    ))}
  </div>

  {dance.length > 0 && (
    <>
      <h2 class="display font-bold text-2xl mt-10 mb-4">Baile</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {dance.map((p) => (
          <Card href={`/portafolio/${p.id}`} title={p.data.title} subtitle={p.data.summary} tags={p.data.stack.slice(0, 4)} cover={img(p.data.cover)} eyebrow={`${p.data.date.getFullYear()} · Personal`} />
        ))}
      </div>
    </>
  )}
</Base>
